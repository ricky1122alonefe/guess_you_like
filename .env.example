# 复制为 .env（已在 .gitignore）
# cp .env.example .env

# PostgreSQL
DATABASE_URL=postgresql://odds:odds@127.0.0.1:5432/odds

# Docker Postgres 镜像（国内网络可改用 DaoCloud）
POSTGRES_IMAGE=postgres:16-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine

# ── AI（也可写在 local_secrets.py）──────────────────
# 项目当前仅使用 DeepSeek
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# AI_ENABLE_KIMI=0

# 已停用：豆包 / Cursor
# ARK_API_KEY=
# DOUBAO_API_KEY=
# DOUBAO_MODEL=doubao-seed-2-0-lite-260428
# CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5

# 服务
# PORT=8765
# POLL_DAYS=7

# 可选：API-Football / OpenWeather（不配也能跑：球场用固定目录，天气 Open-Meteo，伤停网页搜索）
# API_FOOTBALL_KEY=
# OPENWEATHER_API_KEY=

# 可选：football-data.org 积分榜（motivation 战意维）
# 免费版：https://www.football-data.org/ 注册后拿 token，支持英超/西甲/德甲/意甲/法甲。
# 不配也能跑：战意维诚实 missing，不编造；配后运行 `guess-you-like standings --refresh` 预拉缓存。
# FOOTBALL_DATA_API_KEY=
